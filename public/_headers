# Cloudflare Pages headers.
# HTML stays revalidatable; versioned tool CSS and hashed build assets cache hard.

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; media-src 'self'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

/.well-known/*
  Cache-Control: no-cache, no-store, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=3600, must-revalidate

/sitemap-*.xml
  Cache-Control: public, max-age=3600, s-maxage=3600, must-revalidate

/sitemap-index.xml
  Cache-Control: public, max-age=3600, s-maxage=3600, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/*/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/styles/lib/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800

/assets/*
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800

/favicon*
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800

/apple-touch-icon*
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800

/brand-final-48.webp
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800

/og-default.webp
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800
