---
import IdentityFooter from "@jjlmoya/identity/footer";
import packageJson from "../../../package.json";
import { SUPPORTED_LANGUAGES, type Language } from "../../i18n/utils";

interface Props { className?: string; }
const { className = "" } = Astro.props;
const languageFromPath = Astro.url.pathname.split("/")[1] || "en";
const language = SUPPORTED_LANGUAGES.includes(languageFromPath as Language) ? languageFromPath as Language : "en";
---

<IdentityFooter
    identity="gamebob"
    {language}
    version={packageJson.version}
    class={className}
/>
