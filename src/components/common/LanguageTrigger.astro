---
import { Icon } from "astro-icon/components";
import "./LanguageTrigger.css";

interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;
---

<button class={`mobile-icon-btn ${className}`} data-language-trigger aria-label="Change language" aria-controls="mobile-lang-sheet" aria-expanded="false">
    <Icon name="mdi:translate" class="lang-icon" />
</button>

<script>
    function setupLanguageTrigger() {
        const langSheet = document.getElementById("mobile-lang-sheet");
        if (!langSheet) return;

        document.querySelectorAll<HTMLElement>("[data-language-trigger]").forEach((langTrigger) => {
            if (langTrigger.dataset.languageTriggerReady === "true") return;
            langTrigger.dataset.languageTriggerReady = "true";

            langTrigger.addEventListener("click", (e) => {
                e.stopPropagation();
                langSheet.classList.add("active");
                langTrigger.setAttribute("aria-expanded", "true");
            });
        });
    }

    document.addEventListener("astro:page-load", setupLanguageTrigger);
    setupLanguageTrigger();
</script>
