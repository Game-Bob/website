---
import { getTranslatedUrl, getExternalLanguageUrl } from "../../i18n/routerUtils";
import { SUPPORTED_LANGUAGES, externalLanguages } from "../../i18n/utils";
import OpenGraph from "./OpenGraph.astro";
import packageJson from "../../../package.json";

interface Props {
    title: string;
    description: string;
    image?: string;
    favicon?: string;
    article?: boolean;
    publishedTime?: string;
    modifiedTime?: string;
    lang?: string;
    assetVersion?: string;
}

const {
    title,
    description,
    image = "/og-default.webp",
    favicon,
    article = false,
    publishedTime,
    modifiedTime,
    lang = "en",
    assetVersion = packageJson.version,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title;
const appendVersion = (url: string, version = assetVersion): string => {
    if (!url) return url;
    const separator = url.includes("?") ? "&" : "?";
    return `${url}${separator}version=${version}`;
};
const imageURL = new URL(appendVersion(image), Astro.url);

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const isUtility = pathSegments.length === 5;
const manifestUrl = isUtility ? `${Astro.url.pathname}manifest.json` : "/manifest.json";

const alternateUrls: Array<{ lang: string; url: string }> = [];

for (const altLang of SUPPORTED_LANGUAGES) {
    const translatedPath = await getTranslatedUrl(Astro.url.pathname, lang, altLang);
    alternateUrls.push({ lang: altLang, url: new URL(translatedPath, Astro.site).href });
}

const enPath = await getTranslatedUrl(Astro.url.pathname, lang, "en");
const xDefaultUrl = new URL(enPath, Astro.site);

for (const [extLang, extUrl] of Object.entries(externalLanguages)) {
    const externalUrl = await getExternalLanguageUrl({
        pathname: Astro.url.pathname,
        currentLang: lang,
        targetLang: extLang,
        externalDomain: extUrl
    });
    alternateUrls.push({ lang: extLang, url: externalUrl });
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />

<link rel="icon" type="image/x-icon" href={appendVersion(favicon ?? "/favicon.ico", packageJson.version)} />
<link rel="icon" type="image/webp" href={appendVersion(favicon ?? "/favicon.webp", packageJson.version)} sizes="any" />
<link rel="apple-touch-icon" href={appendVersion(favicon ?? (isUtility ? image : "/apple-touch-icon-brand.webp"), packageJson.version)} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content={isUtility ? title : "jjlmoya"} />
<meta name="apple-mobile-web-app-start-url" content={isUtility ? Astro.url.pathname : "/"} />
<link rel="manifest" href={appendVersion(manifestUrl)} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0f172a" />
<meta name="author" content="jjlmoya" />
<meta name="referrer" content="strict-origin-when-cross-origin" />

<link rel="canonical" href={canonicalURL} />
{alternateUrls.map(({ lang: altLang, url }) => (
    <link rel="alternate" hreflang={altLang} href={url} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<OpenGraph title={fullTitle} description={description} imageURL={imageURL} url={Astro.url} lang={lang} article={article} publishedTime={publishedTime} modifiedTime={modifiedTime} />

<script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: "jjlmoya",
    url: Astro.site,
    sameAs: ["https://twitter.com/jjlmoya", "https://github.com/jjlmoya"],
    jobTitle: "Creative Developer",
    worksFor: { "@type": "Organization", name: "GameBob Studio" },
})} />
