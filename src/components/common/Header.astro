---
import IdentityHeader from "@jjlmoya/identity/header";
import {
    getActiveNavigationSection,
    getSiteNavigation,
} from "@jjlmoya/identity/navigation";
import { IDENTITY_HEADER_LABELS } from "../../i18n/identity";
import { SUPPORTED_LANGUAGES, useTranslations, type Language } from "../../i18n/utils";
import type { AlternateUrl } from "../../i18n/routeAlternates";
import LanguageSheet from "./LanguageSheet.astro";
import LanguageTrigger from "./LanguageTrigger.astro";

interface Props { className?: string; alternateUrls: AlternateUrl[]; }

const { className = "", alternateUrls } = Astro.props;
const pathname = Astro.url.pathname;
const languageFromPath = pathname.split("/")[1] || "en";
const language = SUPPORTED_LANGUAGES.includes(languageFromPath as Language) ? languageFromPath as Language : "en";
const translate = useTranslations(language);
const navigation = getSiteNavigation({
    language,
    activeSection: getActiveNavigationSection(pathname, language),
});
---

<IdentityHeader identity="gamebob" homeUrl={`/${language}/`} {navigation} labels={IDENTITY_HEADER_LABELS[language]} class={className}>
    <LanguageTrigger slot="desktop-actions" />
    <LanguageTrigger slot="mobile-actions" />
</IdentityHeader>
<LanguageSheet transUrls={alternateUrls} currentLang={language} title={translate("ui.select_language")} />
