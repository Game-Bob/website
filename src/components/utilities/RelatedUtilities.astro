---
import { useTranslations, type Language } from "../../i18n/utils";
import CardUtility from "./CardUtility.astro";
import "./RelatedUtilities.css";
import type { UtilityItem } from "../../data/utilities/types";

interface Props {
    category: string;
    currentPath: string;
    lang?: string;
    utilities?: UtilityItem[];
}

const { category, currentPath, lang = "en", utilities = [] } = Astro.props;
const t = useTranslations(lang as Language);
const relatedUtilities = utilities.filter(utility => utility.href !== currentPath);
---

{
    relatedUtilities.length > 0 && (
        <section class="related-section">
            <h2 class="related-title">
                {t("ui.related_utils_title")}{" "}
                <span class="category-highlight">{category}</span>
            </h2>
            <div class="related-grid">
                {relatedUtilities.map((u) => (
                    <CardUtility {...u} lang={lang} />
                ))}
            </div>
        </section>
    )
}
