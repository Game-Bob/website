---
import "../styles/global.css";
import "./Layout.css";
import SEO from "../components/common/SEO.astro";
import Footer from "../components/common/Footer.astro";
import Header from "../components/common/Header.astro";
import { getRouteAlternates } from "../i18n/routeAlternates";
import ThemeBoot from "@jjlmoya/identity/theme-boot";
import "@jjlmoya/identity/styles.css";

import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/900.css";

interface Props {
    title: string;
    description: string;
    image?: string;
    favicon?: string;
    bodyClass?: string;
    mainClass?: string;
    headerClass?: string;
    footerClass?: string;
    fullWidth?: boolean;
    noPaddingTop?: boolean;
    lang?: string;
    assetVersion?: string;
    noindex?: boolean;
}

const {
    title,
    description,
    image,
    favicon,
    bodyClass = "",
    fullWidth = false,
    noPaddingTop = false,
    headerClass = "",
    footerClass = "",
    lang = "en",
    assetVersion,
    noindex = false,
} = Astro.props;
const alternateUrls = getRouteAlternates(Astro.url.pathname, lang);
---

<!doctype html>
<html lang={lang} data-identity="gamebob">
    <head>
        <SEO title={title} description={description} image={image} favicon={favicon} lang={lang} assetVersion={assetVersion} noindex={noindex} {alternateUrls} />
        <slot name="head" />

        <ThemeBoot defaultTheme="theme-dark" />
        <script>
            import { installEcosystemTracking } from "@jjlmoya/tracking";

            installEcosystemTracking();
        </script>
    </head>
    <body class={`body-layout ${bodyClass}`}>
        <Header className={headerClass} {alternateUrls} />

        <main class={`main-content ${fullWidth ? "full-width" : ""} ${noPaddingTop ? "no-padding-top" : ""} ${Astro.props.mainClass || ""}`}>
            <slot />
        </main>

        <Footer className={footerClass} />
    </body>
</html>
