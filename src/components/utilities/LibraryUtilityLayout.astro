---
import LayoutUtility from "../../layouts/LayoutUtility.astro";
import UtilityHeader from "./UtilityHeader.astro";
import { type Language } from "../../i18n/utils";
import packageJson from "../../../package.json";

interface Props {
    lang: Language;
    category?: string;
    categoryKey?: string;
    tool: {
        entry: any;
        Component: any;
        SEOComponent: any;
        BibliographyComponent: any;
    };
}

const { lang, tool, category, categoryKey } = Astro.props;
const { entry } = tool;
const { default: Component } = await tool.Component();
const { default: SEOComponent } = await tool.SEOComponent();
const { default: BibliographyComponent } = await tool.BibliographyComponent();

const content = await entry.i18n[lang]!();
const words = content.title.split(" ");
const titleHighlight = words[0] ?? "";
const titleBase = words.slice(1).join(" ");

const enContent = await entry.i18n.en!();
const enSlug = enContent.slug;

let image = enSlug;
if (categoryKey === "converters") {
    image = "universal-image-converter";
}

const getPackageVersion = (key: string): string => {
    const pkgName = `@jjlmoya/utils-${key}`;
    const deps = packageJson.dependencies as Record<string, string>;
    const range = deps[pkgName] || packageJson.version;
    return range.replace(/^[\^~]/, "");
};

const version = getPackageVersion(categoryKey ?? "");
const cssHref = `/styles/lib/${categoryKey}/${enSlug}.css?version=${version}`;
---

<LayoutUtility
    title={content.title}
    description={content.description}
    image={`/images/utilities/${image}.webp`}
    faqItems={content.faq}
    howToSteps={content.howTo}
    category={category}
    lang={lang}
    toolCss={cssHref}
>
    <div slot="header">
        <UtilityHeader
            titleHighlight={titleHighlight}
            titleBase={titleBase}
            description={content.description}
        />
    </div>

    {}
    <Component ui={content.ui} />

    <div slot="seo">
        <SEOComponent locale={lang} />
    </div>

    <div slot="bibliography">
        <BibliographyComponent locale={lang} />
    </div>
</LayoutUtility>
