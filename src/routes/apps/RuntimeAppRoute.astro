---
import Layout from '../../layouts/Layout.astro';
import { SUPPORTED_LANGUAGES, type Language } from '../../i18n/utils';
import type { KnownLocale } from '@jjlmoya/apps/data';

interface Props {
    app: {
        entry: any;
        LandingComponent: any;
    };
}

const { app } = Astro.props;
const langSegment = Astro.url.pathname.split('/').filter(Boolean)[0] ?? 'en';
const lang = (SUPPORTED_LANGUAGES as readonly string[]).includes(langSegment)
    ? langSegment as Language
    : 'en';
const { entry } = app;
const loader = entry.i18n[lang as KnownLocale] ?? entry.i18n.en;

if (!loader) throw new Error(`Missing app locale for ${entry.id}: ${lang}`);

const card = await loader();
const { default: LandingComponent } = await app.LandingComponent() as { default: any };
const iconPath = `/assets/apps/${entry.id}/icon.webp`;
const openGraphImagePath = entry.media?.openGraphImage ?? iconPath;
const openGraphImageUrl = new URL(openGraphImagePath, Astro.site);
const operatingSystem = [
    entry.stores.appStore ? 'iOS' : null,
    entry.stores.googlePlay ? 'Android' : null,
].filter(Boolean).join(', ');

const appSchema = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: card.title,
    description: card.description,
    applicationCategory: entry.isGame ? 'GameApplication' : 'MobileApplication',
    operatingSystem,
    image: openGraphImageUrl.href,
    publisher: {
        '@type': 'Organization',
        name: 'GameBob Studio',
        url: Astro.site,
    },
    ...(entry.stores.appStore && { installUrl: entry.stores.appStore }),
    ...(entry.stores.googlePlay && { installUrl: entry.stores.googlePlay }),
};
---

<Layout title={card.title} description={card.description} image={openGraphImagePath} favicon={iconPath} lang={lang} fullWidth noPaddingTop>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    <LandingComponent locale={lang} />
</Layout>
